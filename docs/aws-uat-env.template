# AWS storefront UAT configuration. No credentials in this template.
# NEXT_PUBLIC_* values must be provided at build time and runtime.
NEXT_PUBLIC_SITE_URL=https://uat.houseofdiams.com
SITE_URL=https://uat.houseofdiams.com
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://media.houseofdiams.com

# Private RDS DNS, hod_app role and hod_staging DB. Strict verified TLS.
DATABASE_URL=REQUIRED_FROM_SECRET_STORE
DB_CA_CERT_PATH=/etc/ssl/certs/aws-rds-us-east-1-bundle.pem
# Omit DB_TLS_EXPECTED_HOST on AWS: it is only for the local SSM tunnel.

# AWS-hosted Keycloak storefront confidential client.
HOD_CUSTOMER_AUTH_BASE_URL=https://uat.houseofdiams.com
HOD_CUSTOMER_OIDC_ISSUER=https://auth-uat.houseofdiams.com/realms/hod-customers
HOD_CUSTOMER_OIDC_CLIENT_ID=hod-storefront
HOD_CUSTOMER_OIDC_CLIENT_SECRET=REQUIRED_FROM_KEYCLOAK
HOD_CUSTOMER_SESSION_SECRET=REQUIRED_FROM_SECRET_STORE

# Initial release gates remain OFF pending controlled UAT.
HOD_CUSTOMER_AUTH_ENABLED=false
HOD_F7_RDS_WRITE_PREPARED=false
HOD_F8_RDS_RECONCILIATION_PREPARED=false

# Existing external payment and FX integrations remain required.
RAZORPAY_CURRENCY=INR
RAZORPAY_KEY_ID=REQUIRED_TEST_MODE_KEY
RAZORPAY_KEY_SECRET=REQUIRED_TEST_MODE_SECRET
RAZORPAY_WEBHOOK_SECRET=REQUIRED_UAT_WEBHOOK_SECRET
CRON_SECRET=REQUIRED_FROM_SECRET_STORE
APILAYER_FIXER_API_KEY=REQUIRED_VALID_FIXER_KEY

# Shared Redis; existing approved Upstash is supported. No new Redis service provisioned.
# Standard AWS Redis with password auth is also supported; use rediss:// for TLS.
REDIS_URL=REQUIRED_SHARED_REDIS_URL

# Storefront SMTP; use SES SMTP credentials if AWS-only email hosting is required.
EMAIL_HOST=REQUIRED_SMTP_HOST
EMAIL_PORT=587
EMAIL_USER=REQUIRED_SMTP_USER
EMAIL_PASS=REQUIRED_SMTP_PASSWORD
EMAIL_FROM=REQUIRED_AUTHORIZED_SENDER

# Optional checkout postal lookup: GOOGLE_GEOCODING_KEY.
# Do not enable IndexNow submissions for UAT.
# No Supabase, Cloudflare/R2, Vercel or F2 transport-selection settings are needed.
